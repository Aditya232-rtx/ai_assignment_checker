# Copy to .env and fill in real values. NEVER commit the real .env.

# Ollama Cloud (OpenAI-compatible). Free-plan example model: gemma4:31b-cloud
USE_OLLAMA_CLOUD=true
OLLAMA_CLOUD_URL=https://ollama.com/v1
OLLAMA_CLOUD_KEY=your-api-key-here
MODEL_NAME=gemma4:31b-cloud

# Optional overrides (auto-detected when omitted):
# - MCA_LABS_NAME: subject folder name inside OneDrive (default mca_labs;
#   MCA_TEST-style shared folders are also auto-found)
# - ONEDRIVE_SYNC_PATH: absolute path to the subject folder
# - GRADING_DB_PATH: SQLite path for the legacy grade-all pipeline
# - OUTPUT_CSV_PATH: CSV output for the legacy grade-all pipeline
